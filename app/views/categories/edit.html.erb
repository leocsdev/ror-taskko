<%= turbo_frame_tag dom_id(@category) do %>
  <div class="p-3.5 bg-indigo-50/40 space-y-2">
    <%= form_with model: @category, class: "flex items-center gap-2" do |form| %>
      <%= form.text_field :name,
            autofocus: true,
            class: "flex-1 rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs text-slate-800 focus:border-indigo-600 focus:outline-none focus:ring-1 focus:ring-indigo-500" %>

      <%= form.button type: :submit,
            class: "inline-flex items-center gap-1 rounded-md bg-indigo-600 px-2.5 py-1.5 text-xs font-semibold text-white transition-colors hover:bg-indigo-700 shrink-0" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"/>
        </svg>
        <span>Save</span>
      <% end %>

      <%# Cancel link restores the normal row %>
      <%= link_to "Cancel",
            category_path(@category),
            class: "rounded-md border border-slate-200 bg-white px-2.5 py-1.5 text-xs font-medium text-slate-600 transition-colors hover:bg-slate-50 hover:text-slate-800 shrink-0" %>
    <% end %>

    <% if @category.errors.any? %>
      <p class="text-xs text-rose-600 font-medium">
        <%= @category.errors.full_messages.to_sentence %>
      </p>
    <% end %>
  </div>
<% end %>
