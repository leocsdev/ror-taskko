<%= form_with model: category, id: "new_category_form", class: "space-y-3" do |form| %>
  <% if category.errors.any? %>
    <div class="rounded-lg border border-rose-200 bg-rose-50 p-2.5 text-xs text-rose-700" role="alert">
      <ul class="list-inside list-disc">
        <% category.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="flex flex-col gap-2.5 sm:flex-row">
    <%= form.text_field :name,
          placeholder: "e.g., Side Hustle, Fitness, Reading",
          autofocus: true,
          class: "flex-1 rounded-lg border #{category.errors.any? ? 'border-rose-300 focus:border-rose-600 focus:ring-rose-500/20' : 'border-slate-300 focus:border-indigo-600 focus:ring-indigo-500/20'} bg-white px-3.5 py-2 text-sm text-slate-800 placeholder:text-slate-400 focus:outline-none focus:ring-2" %>

    <%= form.button type: :submit,
          class: "inline-flex items-center justify-center gap-1.5 rounded-lg bg-indigo-600 px-4 py-2 text-xs font-semibold text-white shadow-xs transition-colors hover:bg-indigo-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 shrink-0" do %>
      <span aria-hidden="true" class="text-sm leading-none">+</span>
      <span>Create Category</span>
    <% end %>
  </div>
<% end %>
