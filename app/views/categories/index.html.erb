<%= turbo_frame_tag "modal" do %>
  <div class="fixed inset-0 z-50 flex items-end justify-center bg-slate-900/40 backdrop-blur-xs p-0 sm:items-center sm:p-4"
       data-controller="modal"
       data-action="keydown@window->modal#closeOnEscape click->modal#backdropClick">

    <div class="flex max-h-[92vh] w-full flex-col overflow-hidden rounded-t-2xl border border-slate-200 bg-white shadow-2xl sm:max-h-[85vh] sm:max-w-xl sm:rounded-2xl"
         role="dialog"
         aria-modal="true"
         aria-labelledby="category-modal-title">

      <%# Header %>
      <div class="flex items-center justify-between border-b border-slate-100 bg-slate-50/50 px-6 py-4.5">
        <div class="flex items-center gap-2.5">
          <div class="rounded-lg border border-indigo-100 bg-indigo-50 p-2 text-indigo-600">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z"/>
              <circle cx="7.5" cy="7.5" r=".5" fill="currentColor"/>
            </svg>
          </div>
          <div>
            <h2 id="category-modal-title" class="text-lg font-semibold tracking-tight text-slate-900">
              Manage Categories
            </h2>
            <p class="mt-0.5 text-xs text-slate-500">
              Create, rename, and delete task classification categories.
            </p>
          </div>
        </div>

        <button type="button"
                data-action="modal#close"
                aria-label="Close dialog"
                class="rounded-lg p-1.5 text-slate-400 transition-colors hover:bg-slate-100 hover:text-slate-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500">
          <span aria-hidden="true" class="text-xl leading-none">&times;</span>
        </button>
      </div>

      <%# Content Body %>
      <div class="flex-1 overflow-y-auto px-6 py-5 space-y-6">
        
        <%# Category List Section %>
        <div>
          <h3 class="mb-2 text-xs font-semibold uppercase tracking-wider text-slate-500">
            Existing Categories (<%= @categories.count %>)
          </h3>

          <div id="categories_list" class="divide-y divide-slate-100 rounded-xl border border-slate-200 bg-white">
            <% if @categories.any? %>
              <% @categories.each do |cat| %>
                <div id="<%= dom_id(cat) %>" class="flex items-center justify-between px-4 py-3 hover:bg-slate-50/70 transition-colors">
                  <div class="flex items-center gap-2.5 min-w-0">
                    <span class="h-2.5 w-2.5 rounded-full shrink-0 bg-indigo-500"></span>
                    <span class="text-sm font-medium text-slate-800 truncate">
                      <%= cat.name %>
                    </span>
                    <span class="text-xs text-slate-400 font-mono tabular-nums">
                      (<%= pluralize(cat.tasks.count, 'task') %>)
                    </span>
                  </div>
                </div>
              <% end %>
            <% else %>
              <div class="p-6 text-center text-xs text-slate-400">
                No categories yet.
              </div>
            <% end %>
          </div>
        </div>

      </div>

      <%# Footer %>
      <div class="flex items-center justify-between border-t border-slate-100 bg-slate-50/50 px-6 py-3.5 text-xs text-slate-500">
        <span>TaskKo Categories</span>
        <button type="button"
                data-action="modal#close"
                class="rounded-lg border border-slate-200 bg-white px-4 py-1.5 text-xs font-semibold text-slate-700 shadow-xs transition-colors hover:bg-slate-50">
          Done
        </button>
      </div>

    </div>
  </div>
<% end %>
