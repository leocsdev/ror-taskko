<% completed = task.completed? %>
<% due_today = task.due_today? %>
<% overdue = task.overdue? %>

<article id="<%= dom_id(task) %>" class="rounded-xl border p-4 transition-colors sm:p-5 <%= completed ? 'border-slate-200/60 bg-slate-50/70 opacity-80' : 'border-slate-200 bg-white hover:border-slate-300' %>">
  <div class="flex items-start gap-3.5 sm:gap-4">
    <%= button_to toggle_completion_task_path(task, status: params[:status], view: @current_view),
          method: :patch,
          aria: { label: completed ? "Reopen #{task.name}" : "Complete #{task.name}", pressed: completed },
          form: { class: "shrink-0" },
          class: "mt-0.5 flex h-5 w-5 items-center justify-center rounded-md border transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 focus-visible:ring-offset-2 #{completed ? 'border-indigo-600 bg-indigo-600 text-white' : 'border-slate-300 bg-white text-transparent hover:border-indigo-500 hover:bg-indigo-50/40'}" do %>
      <% if completed %>
        <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true">
          <path d="m4 10 4 4 8-8" />
        </svg>
      <% end %>
    <% end %>

    <div class="min-w-0 flex-1">
      <div class="flex items-start justify-between gap-3">
        <div class="flex flex-wrap items-center gap-2">
          <h2 class="text-base font-semibold leading-snug tracking-tight <%= completed ? 'text-slate-400 line-through' : 'text-slate-900' %>"><%= task.name %></h2>
          <% if task.ranking_reason.present? %>
            <span class="inline-flex items-center rounded-md px-2 py-0.5 text-[11px] font-semibold <%= overdue ? 'bg-rose-50 text-rose-700 border border-rose-200' : due_today ? 'bg-amber-50 text-amber-700 border border-amber-200' : 'bg-indigo-50 text-indigo-700 border border-indigo-100' %>">
              <%= task.ranking_reason %>
            </span>
          <% end %>
        </div>

        <div class="flex shrink-0 items-center gap-1">
          <%# Edit button %>
          <%= link_to edit_task_path(task),
                data: { turbo_frame: "modal" },
                aria: { label: "Edit task #{task.name}" },
                class: "rounded-md p-1.5 text-slate-400 transition-colors hover:bg-indigo-50 hover:text-indigo-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500" do %>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/>
              <path d="m15 5 4 4"/>
            </svg>
          <% end %>

          <%# Delete button %>
          <%= button_to task_path(task, status: params[:status], view: @current_view),
                method: :delete,
                data: { turbo_confirm: "Delete task \"#{task.name}\"?" },
                aria: { label: "Delete task #{task.name}" },
                class: "rounded-md p-1.5 text-slate-400 transition-colors hover:bg-rose-50 hover:text-rose-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-rose-500" do %>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 6h18"/>
              <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/>
              <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/>
              <line x1="10" x2="10" y1="11" y2="17"/>
              <line x1="14" x2="14" y1="11" y2="17"/>
            </svg>
          <% end %>
        </div>
      </div>

      <% if task.description.present? %>
        <p class="mt-1.5 whitespace-pre-line text-sm leading-relaxed text-slate-600"><%= task.description %></p>
      <% end %>

      <div class="mt-3 flex flex-wrap items-center gap-x-2.5 gap-y-1.5 text-xs text-slate-500">
        <% if task.category.present? %>
          <span class="font-medium text-indigo-700"><%= task.category.name %></span>
        <% end %>

        <% if task.category.present? && task.priority.present? %>
          <span aria-hidden="true" class="text-slate-300">·</span>
        <% end %>

        <% priority_class = {
             "urgent" => "font-semibold text-rose-700 inline-flex items-center gap-1",
             "high"   => "font-semibold text-amber-700",
             "medium" => "font-medium text-sky-700",
             "low"    => "text-slate-600"
           }.fetch(task.priority, "text-slate-600") %>

        <span class="<%= priority_class %>">
          <% if task.priority == "urgent" %>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 text-rose-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <line x1="12" y1="8" x2="12" y2="12"/>
              <line x1="12" y1="16" x2="12.01" y2="16"/>
            </svg>
          <% end %>
          <span><%= task.priority.humanize %></span>
        </span>

        <% if task.due_at.present? %>
          <span aria-hidden="true" class="text-slate-300">·</span>
          <span class="inline-flex items-center gap-1 <%= overdue ? 'font-semibold text-rose-600' : due_today ? 'font-medium text-amber-700' : 'text-slate-500' %>">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="18" height="18" x="3" y="4" rx="2" ry="2"/>
              <line x1="16" x2="16" y1="2" y2="6"/>
              <line x1="8" x2="8" y1="2" y2="6"/>
              <line x1="3" x2="21" y1="10" y2="10"/>
            </svg>
            <span>
              <%= overdue ? "Overdue · #{task.due_at.to_date.to_fs(:long)}" : due_today ? "Due today" : "Due #{task.due_at.to_date.to_fs(:long)}" %>
            </span>
          </span>
        <% end %>

        <% if completed %>
          <span aria-hidden="true" class="text-slate-300">·</span>
          <span class="italic text-slate-400">Completed</span>
        <% end %>
      </div>
    </div>
  </div>
</article>
