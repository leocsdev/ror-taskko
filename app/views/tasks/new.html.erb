<%= turbo_frame_tag "modal" do %>
  <div class="fixed inset-0 z-50 flex items-end justify-center bg-slate-900/40 backdrop-blur-sm sm:items-center sm:p-4" data-controller="modal" data-action="keydown@window->modal#closeOnEscape click->modal#backdropClick">
    <section role="dialog" aria-modal="true" aria-labelledby="task-modal-title" class="flex max-h-[92vh] w-full flex-col overflow-hidden rounded-t-2xl bg-white shadow-xl sm:max-w-xl sm:rounded-xl">
      <header class="flex items-start justify-between border-b border-slate-100 px-5 py-4 sm:px-6">
        <div>
          <h2 id="task-modal-title" class="text-lg font-semibold tracking-tight text-slate-900">Add Task</h2>
          <p class="mt-0.5 text-xs text-slate-500">Capture a new task and choose its details.</p>
        </div>
        <button type="button" aria-label="Close dialog" data-action="modal#close" class="rounded-lg p-1.5 text-slate-400 transition-colors hover:bg-slate-100 hover:text-slate-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500">
          <span aria-hidden="true" class="text-xl leading-none">&times;</span>
        </button>
      </header>

      <%= form_with model: @task, class: "space-y-4 overflow-y-auto px-5 py-5 sm:px-6" do |form| %>
        <% if @task.errors.any? %>
          <div class="rounded-lg border border-rose-200 bg-rose-50 p-3 text-sm text-rose-800" role="alert">
            <p class="font-semibold"><%= pluralize(@task.errors.count, "error") %> prevented this task from being saved:</p>
            <ul class="mt-1 list-inside list-disc">
              <% @task.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div>
          <%= form.label :name, "Task name", class: "mb-1.5 block text-xs font-semibold uppercase tracking-wider text-slate-800" %>
          <%= form.text_field :name, required: true, autofocus: true, placeholder: "e.g., Review PostgreSQL schema migrations", class: "w-full rounded-lg border border-slate-300 bg-white px-3.5 py-2.5 text-sm text-slate-800 focus:border-indigo-600 focus:outline-none focus:ring-2 focus:ring-indigo-500/20" %>
        </div>

        <div>
          <%= form.label :description, class: "mb-1.5 block text-xs font-semibold uppercase tracking-wider text-slate-800" %>
          <%= form.text_area :description, rows: 3, placeholder: "Add context or notes (optional)", class: "w-full rounded-lg border border-slate-300 bg-white px-3.5 py-2.5 text-sm leading-relaxed text-slate-800 focus:border-indigo-600 focus:outline-none focus:ring-2 focus:ring-indigo-500/20" %>
        </div>

        <div>
          <%= form.label :category_id, "Category", class: "mb-1.5 block text-xs font-semibold uppercase tracking-wider text-slate-800" %>
          <%= form.collection_select :category_id, @categories, :id, :name, { include_blank: "No category" }, class: "w-full rounded-lg border border-slate-300 bg-white px-3.5 py-2.5 text-sm text-slate-800 focus:border-indigo-600 focus:outline-none focus:ring-2 focus:ring-indigo-500/20" %>
        </div>

        <div>
          <%= form.label :priority, class: "mb-1.5 block text-xs font-semibold uppercase tracking-wider text-slate-800" %>
          <%= form.select :priority, Task::PRIORITIES.map { |priority| [priority.humanize, priority] }, {}, class: "w-full rounded-lg border border-slate-300 bg-white px-3.5 py-2.5 text-sm text-slate-800 focus:border-indigo-600 focus:outline-none focus:ring-2 focus:ring-indigo-500/20" %>
        </div>

        <div>
          <%= form.label :due_at, "Due date and time (optional)", class: "mb-1.5 block text-xs font-semibold uppercase tracking-wider text-slate-800" %>
          <%= form.datetime_local_field :due_at, class: "w-full rounded-lg border border-slate-300 bg-white px-3.5 py-2.5 text-sm text-slate-800 focus:border-indigo-600 focus:outline-none focus:ring-2 focus:ring-indigo-500/20" %>
        </div>

        <div class="flex items-center justify-end gap-2.5 border-t border-slate-100 pt-4">
          <button type="button" data-action="modal#close" class="rounded-lg px-4 py-2 text-sm font-medium text-slate-600 transition-colors hover:bg-slate-100 hover:text-slate-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-400">Cancel</button>
          <%= form.submit "Save Task", class: "cursor-pointer rounded-lg bg-indigo-600 px-5 py-2 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-indigo-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 focus-visible:ring-offset-2" %>
        </div>
      <% end %>
    </section>
  </div>
<% end %>
