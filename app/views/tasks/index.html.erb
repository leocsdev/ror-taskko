<header class="sticky top-0 z-10 border-b border-slate-200/80 bg-white/95 px-4 py-3.5 backdrop-blur-md sm:px-8">
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-4">
    <div class="flex items-center gap-3">
      <span class="text-xl font-bold tracking-tight text-slate-900">Task<span class="text-indigo-600">ko</span>.</span>
      <span class="hidden border-l border-slate-200 pl-3 text-xs text-slate-400 md:inline-block">Your tasks. Your priorities. Your day.</span>
    </div>
  </div>
</header>

<section class="mx-auto w-full max-w-3xl px-4 py-8 sm:px-6 sm:py-10">
  <div class="flex flex-col justify-between gap-4 border-b border-slate-200/90 pb-5 sm:flex-row sm:items-end sm:pb-6">
    <div>
      <div class="flex items-center gap-2">
        <h1 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">My Tasks</h1>
        <span class="inline-flex items-center rounded-full border border-indigo-100 bg-indigo-50 px-2.5 py-0.5 text-xs font-semibold text-indigo-700">
          <span id="active_tasks_count"><%= @active_tasks_count %></span>
        </span>
      </div>
      <p class="mt-1 text-xs text-slate-500 sm:text-sm">Keep track of daily priorities and pending work.</p>
    </div>
    <%= link_to new_task_path, data: { turbo_frame: "modal" }, class: "inline-flex items-center justify-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-indigo-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 focus-visible:ring-offset-2" do %>
      <span aria-hidden="true" class="text-lg leading-none">+</span>
      <span>Add Task</span>
    <% end %>
  </div>

  <%= render "tasks_list", tasks: @tasks %>

  <%= render "task_summary", tasks: @tasks %>
</section>

<%= turbo_frame_tag "modal" %>
