<div id="tasks_list" class="mt-5 space-y-3">
  <% if tasks.any? %>
    <%= render partial: "task", collection: tasks, as: :task %>
  <% else %>
    <% has_filters = params[:category_id].present? || params[:priority].present? || (params[:status].present? && params[:status] != "all") %>

    <div class="rounded-xl border border-dashed border-slate-300 bg-white px-4 py-12 text-center">
      <div class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-full bg-indigo-50 text-indigo-600">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/>
          <path d="M15 2H9a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V3a1 1 0 0 0-1-1Z"/>
          <path d="m9 14 2 2 4-4"/>
        </svg>
      </div>

      <h2 class="text-sm font-semibold text-slate-900">
        <%= @current_view == "today" ? "All caught up for today" : (has_filters ? "No tasks found" : "No tasks yet") %>
      </h2>

      <p class="mx-auto mt-1 max-w-sm text-xs text-slate-500">
        <% if @current_view == "today" %>
          You have no active tasks requiring immediate attention. Enjoy your day or add a new task.
        <% elsif params[:status] == "completed" %>
          You have not completed any tasks in this view yet.
        <% elsif params[:status] == "active" %>
          You don't have any active tasks right now.
        <% elsif params[:category_id].present? %>
          No tasks recorded under the selected category.
        <% elsif params[:priority].present? %>
          No tasks found with <%= params[:priority].humanize.downcase %> priority.
        <% else %>
          Capture your first task to start organizing your day.
        <% end %>
      </p>

      <div class="mt-4 flex items-center justify-center gap-2">
        <%= link_to new_task_path,
              data: { turbo_frame: "modal" },
              class: "inline-flex items-center gap-1.5 rounded-lg bg-indigo-600 px-3.5 py-1.5 text-xs font-semibold text-white shadow-xs transition-colors hover:bg-indigo-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500" do %>
          <span aria-hidden="true" class="text-sm leading-none">+</span>
          <span>Add Task</span>
        <% end %>

        <% if @current_view == "today" && @total_tasks_count.to_i > 0 %>
          <%= link_to root_path(view: "all"),
                data: { turbo_frame: "tasks_content", turbo_action: "advance" },
                class: "inline-flex items-center gap-1.5 rounded-lg bg-slate-100 px-3.5 py-1.5 text-xs font-medium text-slate-700 transition-colors hover:bg-slate-200" do %>
            <span>View all tasks (<%= @total_tasks_count %>)</span>
          <% end %>
        <% elsif has_filters %>
          <%= link_to root_path(view: "all"),
                data: { turbo_frame: "tasks_content", turbo_action: "advance" },
                class: "inline-flex items-center gap-1.5 rounded-lg bg-slate-100 px-3.5 py-1.5 text-xs font-medium text-slate-700 transition-colors hover:bg-slate-200" do %>
            <span>Clear filters</span>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
