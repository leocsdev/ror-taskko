<%= turbo_frame_tag "modal" do %>
  <div class="fixed inset-0 z-50 flex items-end justify-center bg-slate-900/40 backdrop-blur-xs p-0 sm:items-center sm:p-4"
       data-controller="modal"
       data-action="keydown@window->modal#closeOnEscape click->modal#backdropClick">

    <div class="flex max-h-[92vh] w-full flex-col overflow-hidden rounded-t-2xl border border-slate-200 bg-white shadow-2xl sm:max-h-[85vh] sm:max-w-xl sm:rounded-2xl"
         role="dialog"
         aria-modal="true"
         aria-labelledby="task-modal-title">

      <%# Header %>
      <div class="flex items-center justify-between border-b border-slate-100 bg-slate-50/50 px-6 py-4.5">
        <div class="flex items-center gap-2.5">
          <div class="rounded-lg border border-indigo-100 bg-indigo-50 p-2 text-indigo-600">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="18" height="18" x="3" y="3" rx="2"/>
              <path d="m9 12 2 2 4-4"/>
            </svg>
          </div>
          <div>
            <h2 id="task-modal-title" class="text-lg font-semibold tracking-tight text-slate-900">
              <%= task.persisted? ? "Edit Task" : "Add Task" %>
            </h2>
            <p class="mt-0.5 text-xs text-slate-500">
              <%= task.persisted? ? "Update this task's details and priority." : "Capture a new task and choose its details." %>
            </p>
          </div>
        </div>

        <button type="button"
                data-action="modal#close"
                aria-label="Close dialog"
                class="rounded-lg p-1.5 text-slate-400 transition-colors hover:bg-slate-100 hover:text-slate-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500">
          <span aria-hidden="true" class="text-xl leading-none">&times;</span>
        </button>
      </div>

      <%# Form with Form Body + Sticky Footer %>
      <%= form_with model: task, class: "flex flex-col flex-1 overflow-hidden" do |form| %>
        <div class="flex-1 overflow-y-auto px-6 py-5 space-y-4">
          <%# Top Error Alert Banner (matching Category error styling) %>
          <% if task.errors.any? %>
            <div role="alert" class="rounded-lg border border-rose-200 bg-rose-50/80 p-3 text-xs text-rose-700">
              <div class="flex items-center gap-1.5 font-semibold text-rose-800">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 shrink-0 text-rose-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"/>
                  <line x1="12" x2="12" y1="8" y2="12"/>
                  <line x1="12" x2="12.01" y1="16" y2="16"/>
                </svg>
                <span><%= pluralize(task.errors.count, "error") %> prevented this task from being saved:</span>
              </div>
              <ul class="mt-1.5 list-inside list-disc space-y-0.5 pl-5 text-rose-600">
                <% task.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <%# Task Name %>
          <div>
            <%= form.label :name, "Task name", class: "mb-1.5 block text-xs font-semibold uppercase tracking-wider text-slate-700" %>
            <div class="flex-1 min-w-0">
              <%= form.text_field :name,
                    autofocus: true,
                    placeholder: "e.g., Review PostgreSQL schema migrations",
                    class: "w-full rounded-lg border #{task.errors[:name].any? ? 'border-rose-400 focus:border-rose-600 focus:ring-rose-500/20' : 'border-slate-300 focus:border-indigo-600 focus:ring-indigo-500/20'} bg-white px-3.5 py-2 text-sm text-slate-800 placeholder:text-slate-400 focus:outline-none focus:ring-2" %>
            </div>
            <% if task.errors[:name].any? %>
              <p role="alert" class="mt-1 flex items-center gap-1 text-xs font-medium text-rose-600">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"/>
                  <line x1="12" x2="12" y1="8" y2="12"/>
                  <line x1="12" x2="12.01" y1="16" y2="16"/>
                </svg>
                <span>Name <%= task.errors[:name].to_sentence %></span>
              </p>
            <% end %>
          </div>

          <%# Description %>
          <div>
            <%= form.label :description, "Description", class: "mb-1.5 block text-xs font-semibold uppercase tracking-wider text-slate-700" %>
            <%= form.text_area :description,
                  rows: 3,
                  placeholder: "Add context or notes (optional)",
                  class: "w-full rounded-lg border border-slate-300 bg-white px-3.5 py-2 text-sm leading-relaxed text-slate-800 placeholder:text-slate-400 focus:border-indigo-600 focus:outline-none focus:ring-2 focus:ring-indigo-500/20" %>
          </div>

          <%# Category %>
          <div>
            <%= form.label :category_id, "Category", class: "mb-1.5 block text-xs font-semibold uppercase tracking-wider text-slate-700" %>
            <%= form.collection_select :category_id, categories, :id, :name,
                  { include_blank: "No category" },
                  class: "w-full rounded-lg border border-slate-300 bg-white px-3.5 py-2 text-sm text-slate-800 focus:border-indigo-600 focus:outline-none focus:ring-2 focus:ring-indigo-500/20" %>
          </div>

          <%# Priority %>
          <div>
            <%= form.label :priority, "Priority", class: "mb-1.5 block text-xs font-semibold uppercase tracking-wider text-slate-700" %>
            <%= form.select :priority,
                  Task::PRIORITIES.map { |priority| [priority.humanize, priority] },
                  {},
                  class: "w-full rounded-lg border #{task.errors[:priority].any? ? 'border-rose-400 focus:border-rose-600 focus:ring-rose-500/20' : 'border-slate-300 focus:border-indigo-600 focus:ring-indigo-500/20'} bg-white px-3.5 py-2 text-sm text-slate-800 focus:outline-none focus:ring-2" %>
            <% if task.errors[:priority].any? %>
              <p role="alert" class="mt-1 flex items-center gap-1 text-xs font-medium text-rose-600">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"/>
                  <line x1="12" x2="12" y1="8" y2="12"/>
                  <line x1="12" x2="12.01" y1="16" y2="16"/>
                </svg>
                <span>Priority <%= task.errors[:priority].to_sentence %></span>
              </p>
            <% end %>
          </div>

          <%# Due Date %>
          <div>
            <%= form.label :due_at, "Due date and time (optional)", class: "mb-1.5 block text-xs font-semibold uppercase tracking-wider text-slate-700" %>
            <%= form.datetime_local_field :due_at,
                  class: "w-full rounded-lg border border-slate-300 bg-white px-3.5 py-2 text-sm text-slate-800 focus:border-indigo-600 focus:outline-none focus:ring-2 focus:ring-indigo-500/20" %>
          </div>
        </div>

        <%# Modal Footer %>
        <div class="flex items-center justify-between border-t border-slate-100 bg-slate-50/50 px-6 py-3.5 text-xs text-slate-500">
          <span>Task details</span>
          <div class="flex items-center gap-2">
            <button type="button"
                    data-action="modal#close"
                    class="rounded-lg border border-slate-200 bg-white px-4 py-2 text-xs font-semibold text-slate-700 shadow-xs transition-colors hover:bg-slate-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-400">
              Cancel
            </button>
            <%= form.button type: :submit,
                  class: "inline-flex items-center justify-center gap-1.5 rounded-lg bg-indigo-600 px-4 py-2 text-xs font-semibold text-white shadow-xs transition-colors hover:bg-indigo-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 shrink-0 cursor-pointer" do %>
              <span><%= task.persisted? ? "Update Task" : "Save Task" %></span>
            <% end %>
          </div>
        </div>
      <% end %>

    </div>
  </div>
<% end %>
